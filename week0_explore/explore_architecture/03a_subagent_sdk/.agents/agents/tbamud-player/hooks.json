{
  "auto-allow-python": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/allow_python.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "example-linter": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/lint.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
