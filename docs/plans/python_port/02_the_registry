## 4. Implementation Details

### A. `boukensha/errors.py`
```python
class UnknownToolError(Exception):
    """Raised when dispatching a tool that has not been registered."""
    pass
```

### B. `boukensha/registry.py`
```python
from __future__ import annotations

from typing import Any, Callable, Optional
from .tool import Tool
from .errors import UnknownToolError


class Registry:
    """Manages tool registration and execution dispatch."""

    def __init__(self) -> None:
        self.tools: dict[str, Tool] = {}

    def register_tool(self, tool: Tool) -> None:
        self.tools[tool.name] = tool

    def tool(
        self,
        name: str,
        description: str,
        parameters: Optional[dict[str, Any]] = None,
        block: Optional[Callable[..., Any]] = None,
    ) -> Tool:
        if parameters is None:
            parameters = {}
        t = Tool(name=str(name), description=description, parameters=parameters, block=block)
        self.register_tool(t)
        return t

    def dispatch(self, name: str, args: Optional[dict[str, Any]] = None) -> Any:
        if args is None:
            args = {}
        t = self.tools.get(str(name))
        if t is None:
            raise UnknownToolError(f"No tool registered as '{name}'")
        if t.block is None:
            raise ValueError(f"Tool '{name}' has no executable block")
        return t.block(**args)
```

### C. `boukensha/context.py` (Decoupled from Tools)
```python
from __future__ import annotations

from typing import Any, Optional
from .message import Message


class Context:
    """Holds conversation state (task, system prompt, messages)."""

    def __init__(self, task: Any, system: Optional[str] = None) -> None:
        self.task = task
        self.system = system
        self.messages: list[Message] = []

    def add_message(self, role: str, content: str, tool_use_id: Optional[str] = None) -> None:
        self.messages.append(Message(role=role, content=content, tool_use_id=tool_use_id))

    @property
    def turn_count(self) -> int:
        return len(self.messages)

    def __str__(self) -> str:
        task_name = self.task.task_name() if hasattr(self.task, "task_name") else getattr(self.task, "task_name", None)
        return f"#<Context task={task_name} turns={self.turn_count}>"

    def __repr__(self) -> str:
        return self.__str__()
```

