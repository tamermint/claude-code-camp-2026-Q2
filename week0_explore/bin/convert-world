#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

PARSER_DIR="$PROJECT_DIR/circlemud-world-parser"
SRC="$PROJECT_DIR/infrastructure/lib/world"
DEST="$PROJECT_DIR/preview/data/world"

cd "$PARSER_DIR"

# Ensure environment is synced
uv venv --python 3.14
uv pip install -e .

# Execute Python exactly ONCE, passing the directories
echo "Starting batch parse..."
.venv/bin/circlemud-parse --src "$SRC" --dest "$DEST"

echo "Done. JSON written to $DEST"