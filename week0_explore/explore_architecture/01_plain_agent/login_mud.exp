#!/usr/bin/expect -f
set timeout 10
spawn telnet localhost 4000

expect "By what name do you wish to be known?"
send "dummy\r"

expect "Password:"
send "helloworld\r"

# After logging in, MUDs typically show a MOTD and then a prompt.
expect "*** PRESS RETURN:"
send "\r"

# Wait for the menu and select "1" to enter the game
expect "Make your choice:"
send "1\r"

# Wait to see the game output
expect {
    "*" {
        # Keep reading for a while
        set timeout 5
        expect {
            "*" { }
        }
    }
}
expect eof
