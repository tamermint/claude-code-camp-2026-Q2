### E. Isolated Virtual Environment Runner (`week1_baseline/bin/python/01_struct_skeleton.sh`)
```bash
#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PYTHON_DIR="$SCRIPT_DIR/../../python/01_struct_skeleton"
VENV_DIR="$PYTHON_DIR/.venv"

cd "$PYTHON_DIR"

# Ensure isolated virtual environment exists
if [[ ! -d "$VENV_DIR" ]]; then
    python3 -m venv "$VENV_DIR"
fi

# Install requirements strictly inside the virtual environment
"$VENV_DIR/bin/pip" install -q -r requirements.txt

# Execute example with the virtual environment's Python
"$VENV_DIR/bin/python" examples/example.py
```

